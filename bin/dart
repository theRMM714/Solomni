#!/usr/bin/env bash
# bin/dart -- WSL/Linux/Mac 包装：platform/<os> 平台目录 + 仓库内缓存
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$DIR/.." && pwd)"
case "$(uname -s)" in
  Darwin*) OS=macos ;;
  *)       OS=linux ;;
esac
P="$ROOT/platform/$OS"
export PUB_CACHE="$P/pub-cache"
export TMP="$P/tmp"; export TEMP="$TMP"
# HOME 指向平台目录内：分析器缓存/工具配置写入可写范围
export HOME="$P/dart-home"
if [ -x "$P/dart-sdk/bin/dart" ]; then
  exec "$P/dart-sdk/bin/dart" "$@"
fi
echo "Dart SDK 未安装，先运行: node bin/setup.mjs" >&2
exit 1
