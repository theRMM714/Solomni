#!/usr/bin/env bash
# bin/dart —— WSL/Linux/Mac 包装：内部设好缓存后调用仓库内的 Dart SDK
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$DIR/.." && pwd)"
export PUB_CACHE="$ROOT/.pub-cache"
export TMP="$ROOT/.tmp"; export TEMP="$TMP"
if [ -x "$ROOT/dart-sdk/dart-sdk/bin/dart" ]; then
  exec "$ROOT/dart-sdk/dart-sdk/bin/dart" "$@"
else
  echo "Dart SDK 未安装，先运行: node bin/setup.mjs" >&2
  exit 1
fi
