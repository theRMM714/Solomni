#!/usr/bin/env bash
# ui_flutter 的开发态启动脚本（Unix 侧）。产品宿主经它拉起本模块。
# 职责（模块自决，产品不参与）：
#   1) 自选设备：按当前系统给 flutter run -d
#   2) 起守护入口 bin/coordinated.dart，端口由产品注入（--port=N 转发）
# 依赖自愈已上收 bin/flutter（平台配置快照秒级换入），此处不再重复。
set -euo pipefail

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$SELF_DIR/../../../../"
FLUTTER="$ROOT/bin/flutter"

# 平台判定（本脚本只在 Unix 侧被调用）
case "$(uname -s)" in
  Darwin) DEVICE=macos ;;
  *)      DEVICE=linux ;;
esac

# 参数转发：本 SDK 版本的 flutter run 会丢弃 -- 分隔符后的参数，
# 须逐个转成 --dart-entrypoint-args=<arg> 才能到达 main(List<String> args)。
# 另注入模块根目录：Flutter 运行时无法反推包根，私有数据路径须显式传入。
ENTRY_ARGS=("--dart-entrypoint-args=--module-dir=$SELF_DIR")
for a in "$@"; do
  ENTRY_ARGS+=("--dart-entrypoint-args=$a")
done

exec "$FLUTTER" run -t bin/coordinated.dart -d "$DEVICE" "${ENTRY_ARGS[@]}"
