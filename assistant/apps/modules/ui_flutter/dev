#!/usr/bin/env bash
# ui_flutter 的开发态启动脚本（Unix 侧）。产品装配器经它拉起本模块。
# 职责（模块自决，产品不参与）：
#   1) 依赖自愈：.dart_tool 里 SDK 依赖是工具链写死的绝对路径（平台相关），
#      检测异侧/缺失配置则先 pub get（纯 path 依赖的包两侧通用，不会命中）
#   2) 自选设备：按当前系统给 flutter run -d
#   3) 起守护入口 bin/coordinated.dart，端口由产品注入（--port=N 透传）
set -euo pipefail

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$SELF_DIR/../../../../"
FLUTTER="$ROOT/bin/flutter"

# 平台判定（本脚本只在 Unix 侧被调用）
case "$(uname -s)" in
  Darwin) DEVICE=macos ;;
  *)      DEVICE=linux ;;
esac

# 依赖自愈：异侧 = 出现盘符绝对路径（file:///X:/…）；缺失同理
CFG="$SELF_DIR/.dart_tool/package_config.json"
if [ ! -f "$CFG" ] || grep -q '"rootUri": "file:///[A-Za-z]:/' "$CFG"; then
  echo "[ui_flutter] 依赖配置异侧/缺失，重新解析…"
  "$FLUTTER" pub get
fi

exec "$FLUTTER" run -t bin/coordinated.dart -d "$DEVICE" -- "$@"
