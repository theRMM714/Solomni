quest":"查询 limit / before","response":"{head,commits,total,truncated}","statuses":[200,404]},{"capability":"WorkOps::work_commit_view / work_commit_file","id":"session.work.commit","method":"GET","note":"提交详情；带 path = 该提交里这个文件的受限预览（文本 16 KiB，二进制只给元信息）","pattern":"/api/sessions/{sid}/work/{commit}","request":"查询 path（可选）","response":"{id,parent,author,session,time,message,changes,changes_truncated} / {path,hash,size,media_type,text,truncated,too_large}","statuses":[200,404]},{"capability":"宿主目录浏览","id":"dirs","method":"GET","note":"建会话时选工作区目录用；只在本机 Web 上提供目录列表，不读写文件内容","pattern":"/api/dirs","request":"查询 path（可选；省略 = 用户主目录）","response":"{path,parent,roots:[盘符],dirs:[{name,path}]}","statuses":[200,400]},{"capability":"RegistryOps::settings","id":"settings.get","method":"GET","note":"基本设置","pattern":"/api/settings","request":"—","response":"{settings}","statuses":[200,400]},{"capability":"HistoryOps::list","id":"history.list","method":"GET","note":"落盘会话清单","pattern":"/api/history","request":"—","response":"{sessions}","statuses":[200,400]},{"capability":"HistoryOps::open","id":"history.open","method":"GET","note":"读回历史：盘上转录 + 事件台上它之外的实时尾巴 + 合流时的头部序号（水位）","pattern":"/api/history/{name}","request":"—","response":"{meta,events,live,head,shell}","statuses":[200,404]},{"capability":"HistoryOps::delete","id":"history.delete","method":"POST","note":"删除会话时核心会请求撤销该会话的围栏授权","pattern":"/api/history/{name}/delete","request":"—","response":"{ok}","statuses":[200,400]},{"capability":"WorkOps::tier_choices","id":"tiers","method":"GET","note":"新建工作的档位选择：默认档 + 虚拟机档的**机器能力**可用性与逐项前置 + 可选虚拟根清单（虚拟根是会话级，不在这里判）","pattern":"/api/tiers","request":"—","response":"{tiers:{default,vm_available,vm_unavailable_reason,vm_requirements,guests,available}}","statuses":[200,400]},{"capability":"Provision::processes","id":"processes","method":"GET","note":"现在在跑什么：产品亲手起的长驻子进程（QEMU / 共享进程）与它们的归属；`alive=false` 表示账上还留着、进程已没（等对账清）","pattern":"/api/processes","request":"—","response":"{procs:[{pid,alive,purpos