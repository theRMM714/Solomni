# ==================================================================
# Solomni —— 只提交源码与文档；工具链/SDK/缓存/会话记录一律不入库
#
# git 是 Windows 侧与 WSL 侧之间唯一的桥：
#    clone 这个仓库只会拿到 assistant/ 源码 + 文档；
#    Flutter/Dart SDK、Pub 缓存、会话日志两边各自本地管理，绝不进 git 历史。
# ==================================================================

# ---- 工具链 / SDK（体积巨大；平台后缀目录，Windows/WSL 共仓库互不覆盖）----
# 注意：gitignore 不支持 {a,b,c} 花括号展开，必须逐个枚举
/flutter-linux/
/flutter-windows/
/flutter-macos/
/dart-sdk-linux/
/dart-sdk-windows/
/dart-sdk-macos/
/flutter_windows_*.zip
/.pub-cache-linux/
/.pub-cache-windows/
/.pub-cache-macos/
/.dart-home-linux/
/.dart-home-windows/
/.dart-home-macos/
/.tmp-linux/
/.tmp-windows/
/.tmp-macos/
/.tools/

# ---- 会话 / 私密记录 ----
/session.jsonl

# ---- Dart / Flutter 构建产物（assistant 内各 package）----
**/.dart_tool/
**/build/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages

# ---- IDE / 编辑器 ----
.idea/
*.iml
.vscode/

# ---- 一次性 Windows 下载脚本（已删除，改为仓库内 setup 脚本统一处理）----
