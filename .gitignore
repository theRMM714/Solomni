# ==================================================================
# Solomni —— 只提交源码、文档与保留目录的占位文件；工具链/构建产物/会话记录一律不入库
# ==================================================================

# ---- Rust 构建产物 ----
/target/

# ---- 本地工具链（rustup 安装收纳地，跨平台互不覆盖）----
/platform/

# ---- 运行记录 ----
/logs/
/session/

# ---- 模块私有数据（密钥/历史/缓存等，不可再生）----
# 数据归模块，落在各模块自己文件夹内的 userdata/。永不入库。
# 警告：切勿 git clean -fdx 清掉 userdata——里面是真实用户数据，不随源码走。
**/userdata/

# ---- 本地工具区（运行时环境，不入库）----
/.tools/
/.home/

# ---- 虚拟机档本地环境（QEMU / guest 基础根 / 下载缓存，由 solomni --provision 装到项目内，不入库）----
/.vm/

# ---- 模块的编译产物（例如 C++ 模块构建出来的可执行文件）----
# 源码与构建说明入库，产物不入库：modules/<id>/build/ 由模块自己的 README 一行命令生成。
modules/*/build/

# ---- 运行包依赖文件夹（用户放入的第三方包，不入库）----
# 包 = 一个文件夹 + package.yaml，放入即出现；内容多为二进制，只提交源码与文档，故不入库。
# 目录本身要留住（克隆后它就是用户的投放口）：只忽略里面的包，用占位文件保住目录。
/runtimes/*
!/runtimes/.gitkeep

# ---- 截图/审计产物（tests/screenshots 本地生成，不入库）----
/.shots/

# ---- 突变测试产物（cargo-mutants，本地运行会生成）----
/mutants.out/
/mutants.out.old/

# ---- Node 工具链（前端类型检查；只提交清单与锁文件）----
/node_modules/

# ---- IDE / 编辑器 ----
.idea/
*.iml
.vscode/*
!.vscode/settings.json