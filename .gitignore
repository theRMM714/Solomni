# ==================================================================
# Solomni —— 只提交源码与文档；工具链/构建产物/会话记录一律不入库
# ==================================================================

# ---- Rust 构建产物 ----
/target/

# ---- 本地工作文档 ----
/待优化问题.md

# ---- 本地工具链（rustup 安装收纳地，跨平台互不覆盖）----
/platform/

# ---- 运行记录 ----
/logs/
/session/

# ---- 模块私有数据（密钥/历史/缓存等，不可再生）----
# 数据归模块，落在各模块自己文件夹内的 userdata/。永不入库。
# 警告：切勿 git clean -fdx 清掉 userdata——里面是真实用户数据，不随源码走。
**/userdata/

# ---- 本地工具区（运行时环境，不入库）----
/.tools/
/.home/

# ---- 模块的编译产物（例如 C++ 模块构建出来的可执行文件）----
# 源码与构建说明入库，产物不入库：modules/<id>/build/ 由模块自己的 README 一行命令生成。
modules/*/build/

# ---- 运行包依赖文件夹（用户放入的第三方包，不入库）----
# 包 = 一个文件夹 + package.yaml，放入即出现；内容多为二进制，只提交源码与文档，故不入库。
/runtimes/

# ---- 误入库的 npm 默认产物 ----
# 本项目的 Node 只用于测试入口（node run-tests.js）与前端冒烟，不走 npm 包管理：根目录的 package.json
# 是 npm init 的默认产物，与项目无关，不入库（出现过一次，这里钉住）。
/package.json

# ---- IDE / 编辑器 ----
.idea/
*.iml
.vscode/