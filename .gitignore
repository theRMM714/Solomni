# ==================================================================
# Solomni —— 只提交源码、文档与保留目录的占位文件；工具链/构建产物/会话记录一律不入库
# ==================================================================

# ---- Rust 构建产物 ----
/target/

# ---- 临时文件目录（讨论稿、探针、日志；用完即删，不入库）----
/.tmp/

# ---- 门禁产物（结构图每次跑 T0 覆盖，属测试产物不入库）----
/Structure.html

# ---- 多 agent 工作树（本地并行分支，不入库）----
/.worktrees/

# ---- 本地工具链（rustup 安装收纳地，跨平台互不覆盖）----
/platform/

# ---- 产品可变状态（data/：配置、台账、日志、会话、镜像、模块私有区、运行包）----
# 产品自己写的东西全在这里，一块盘一个主：介质名与子路径只在 src/kernel/domain/layout.rs 里拼。
# 里面是运行状态与用户数据，永不入库；只留占位文件保住投放口（克隆后 data/ 就在）。
/data/*
!/data/.gitkeep

# ---- 本地工具区（运行期环境，不入库）----
/.tools/

# ---- 本机 CLI 状态（gh 等工具按 XDG 把 state 写到这里；与产品无关，不入库）----
/.local/

# ---- 便携入口（--setup=path 生成的 shim，随机器而变，不入库）----
/bin/

# ---- 截图/审计产物（tests/screenshots 本地生成，不入库）----
/.shots/

# ---- 突变测试产物（cargo-mutants，本地运行会生成）----
/mutants.out/
/mutants.out.old/

# ---- Node 工具链（前端类型检查；只提交清单与锁文件）----
/node_modules/

# ---- 字面量路径残渣（工具把 %SystemDrive% 这类变量当目录名建出来的空壳，不入库）----
/%SystemDrive%/

# ---- IDE / 编辑器 ----
.idea/
*.iml
.vscode/*
!.vscode/settings.json
